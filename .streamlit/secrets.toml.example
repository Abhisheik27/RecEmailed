# ============================================================
# RecEmailed — Streamlit Cloud Secrets
# ============================================================
# This file is ONLY needed for Streamlit Cloud deployment.
# When running locally, credentials.json + token.json are used instead.
#
# HOW TO SET UP:
# 1. Run the app locally first to generate token.json
# 2. Copy the ENTIRE contents of token.json
# 3. Paste it below as the google_token value
# 4. Add your Google Sheet URL
# 5. In Streamlit Cloud: Settings → Secrets → paste this file's contents
# ============================================================

# Your Google Sheet URL (so the app connects automatically)
sheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# Paste the ENTIRE contents of your token.json as a single-line string here
# Example: google_token = '{"token": "ya29...", "refresh_token": "1//...", ...}'
google_token = 'PASTE_YOUR_TOKEN_JSON_HERE'
